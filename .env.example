# Receipt Generator Admin Access
# Email address allowed to access the admin receipt generator
# Defaults to Susan's email if not set
ADMIN_EMAIL=morrowsus@gmail.com

# Email Service (Resend preferred)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=noreply@yourdomain.com

# Alternative: SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Other email settings
RECEIVING_EMAIL=morrowsus@gmail.com

# Contact-form test routing (LAC-3652)
# When the contact form is submitted with CONTACT_TEST_EMAIL as the sender
# address, the message is rerouted to CONTACT_TEST_RECIPIENT (an inbox we
# control) instead of RECEIVING_EMAIL — so the full submit → send → deliver
# path can be verified end-to-end without emailing Susan. Both are optional
# and fall back to the defaults shown below.
CONTACT_TEST_EMAIL=test@test.com
CONTACT_TEST_RECIPIENT=admin@buildandsurf.com

# For production deployments
VERCEL_URL=your-domain.com
NEXTAUTH_URL=https://your-domain.com